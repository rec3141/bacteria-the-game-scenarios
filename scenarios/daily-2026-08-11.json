  "meta": {
    "title": "Baltic Sponge Loop: Freshwater Reef Recyclers",
    "date": "2026-08-11",
    "lesson": "Freshwater sponges in cold, dim littoral zones filter dissolved organic carbon from the water and host dense symbiotic bacterial communities in their tissue (mesohyl), which respire and recycle nutrients back into the food web - the 'sponge loop.' This scenario models a phototroph-poor, DOC-rich microhabitat where carbohydrate-class exudate dominates and bacteria must specialize in carbohydrate breakdown while avoiding sluggish but persistent grazers in cold water.",
    "citation": "Modeled loosely on sponge-loop DOC recycling studies applied conceptually to cold littoral/benthic microbial mats.",
    "difficulty": "normal",
    "realWorldBasis": "Sponge mesohyl DOC recycling loop, cold temperate benthic zone"
  },
